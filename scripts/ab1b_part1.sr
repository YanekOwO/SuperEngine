try{ if (__debug == false) return; }
catch(e){ return; }

fn que(scene, choice) {
  try{
    if (__scene == nil || __scene == scene)
      __debug_queue_sel_choice(choice);
  } catch(e) { print("failed to register", scene, choice, e); }
}

