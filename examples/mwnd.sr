
mw = Mwnd(0);

print("mwnd init ok");

fn Textout(text, pause_ms = 140){
  len = text.len();
  for(i=0; i<len; i+=1){
    should_pause = i != len-1;
    mw.disp(text[i], text.suffix(len-i));
    if(should_pause)
      await async.Sleep(pause_ms);
  }
}

// WAKU.BTN.CNT reserves the slots; empty FILE slots can be populated by scripts.
// button returns the selected window's fixed list of ordinary Object handles.
buttons = mw.button;
if (buttons.size() > 0) {
  button = buttons[0];
  button.x = 4; // Additional offset from the template's WAKU.BTN.POS anchor.
  button.set_button_state_normal();
}
